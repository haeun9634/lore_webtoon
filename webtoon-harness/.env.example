# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 에 있음)
# 모델 이름은 여기에만 있습니다. config.yaml 에는 실험 조건만 둡니다.

# 텍스트 LLM 과 이미지 모델이 같은 키를 씁니다.
GEMINI_API_KEY=여기에_키를_넣으세요

# prompt_gen / cut_split 용 텍스트 모델 (story-harness 와 같은 계열)
GEMINI_TEXT_MODEL=gemini-3.5-flash

# render 용 이미지 모델 (char-harness 와 같은 모델)
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ── OpenAI 로 갈아탈 때 ────────────────────────────────
# 아래 둘(WEBTOON_IMAGE_PROVIDER · WEBTOON_TEXT_PROVIDER)을 openai 로 적으면
# 키와 모델을 읽어 올 이름도 **자동으로 함께 바뀝니다.** 그래서 실제로 손댈
# 것은 여기 한 줄과 아래 OPENAI_* 값뿐입니다.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_MODEL=gpt-4.1

# 컷(그림)을 어느 쪽으로 그릴지: gemini | openai | mock
# 비워 두면 config.yaml 의 provider.name (지금은 gemini) 그대로입니다.
#   openai → 키 OPENAI_API_KEY · 모델 OPENAI_IMAGE_MODEL 로 자동 전환
#   mock   → API 를 안 부르고 자리표시자 그림. 과금 없이 흐름만 볼 때.
# (시트 쪽은 story-harness 의 SHEET_IMAGE_PROVIDER 가 따로 정합니다.)
#
# 주의: openai 는 aspect_ratio 를 가장 가까운 크기(9:16 → 1024x1536)로만
# 맞추고 seed 를 안 받습니다 — 자세한 차이는 config.yaml 의 provider 절 참고.
WEBTOON_IMAGE_PROVIDER=

# 글(콘티 옮기기·컷 나누기)을 어느 쪽으로 쓸지: gemini | openai
# 그림과 **따로** 고릅니다 — 그림은 Gemini, 글은 OpenAI 같은 조합이 됩니다.
# 비워 두면 config.yaml 의 text.provider (기본 gemini) 그대로입니다.
WEBTOON_TEXT_PROVIDER=

# 키·모델 env 이름을 직접 정하고 싶을 때만 (보통은 비워 둡니다).
# 위 provider 전환이 정해 주는 기본 이름을 덮어씁니다.
WEBTOON_IMAGE_KEY_ENV=
WEBTOON_IMAGE_MODEL_ENV=
WEBTOON_TEXT_KEY_ENV=
WEBTOON_TEXT_MODEL_ENV=
